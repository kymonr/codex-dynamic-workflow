{
  "version": 1,
  "name": "adversarial-review-example",
  "preset": "adversarial-review",
  "agent_count": 6,
  "objective": "使用多个 fresh Luna 对冻结候选进行多视角发现、质疑和独立复现，并只在宿主规则触发时调用 fresh Sol/xhigh 裁决。",
  "acceptance_criteria": [
    "所有 P1/P2 主张都有具体代码或验证证据。",
    "候选在固定验证和全部 Fleet 阶段保持同一 revision。",
    "一个可复现的少数派 blocker 不会被多数 clean 结果覆盖。"
  ],
  "scope": [
    "审核 package 中声明的 Git 候选、changed files、patch、untracked content 和固定验证证据。"
  ],
  "exclusions": [
    "不修改候选或仓库文件。",
    "不安装依赖、不访问网络、不执行 Git 写操作。",
    "不把代理数量或多数意见当作正确性证据。"
  ],
  "candidate": {
    "repository_full_name": "kymonr/codex-dynamic-workflow",
    "expected_head_sha": "0000000000000000000000000000000000000000",
    "changed_files": [
      "skill/fleet_runtime.py",
      "skill/fleet_findings.py",
      "skill/tests/test_agent_fleet_runtime.py"
    ]
  },
  "risk_tags": [
    "integrity"
  ],
  "verification": {
    "required_ids": [
      "fleet-tests",
      "policy-consistency"
    ],
    "commands": [
      {
        "id": "fleet-tests",
        "argv": [
          "python",
          "-m",
          "unittest",
          "skill.tests.test_agent_fleet_contract",
          "skill.tests.test_agent_fleet_presets",
          "skill.tests.test_agent_fleet_findings",
          "skill.tests.test_agent_fleet_runtime",
          "skill.tests.test_agent_fleet_cli",
          "skill.tests.test_agent_fleet_policy"
        ],
        "timeout_seconds": 600
      },
      {
        "id": "policy-consistency",
        "argv": [
          "python",
          "skill/scripts/check_policy_consistency.py",
          "--json"
        ],
        "timeout_seconds": 120
      }
    ]
  },
  "limits": {
    "max_patch_bytes": 524288,
    "max_untracked_file_bytes": 131072,
    "max_candidate_bytes": 1048576,
    "max_agent_output_bytes": 524288,
    "max_agent_log_bytes": 1048576
  }
}

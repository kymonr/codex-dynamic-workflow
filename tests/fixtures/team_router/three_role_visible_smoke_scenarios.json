{
  "schemaVersion": 1,
  "purpose": "Fixture snapshot for the visible three-role Team Router mode.",
  "roles": {
    "manager": "规划者",
    "executor": "执行者",
    "verifier": "验证者"
  },
  "parentSideConcepts": [
    "父线程调度者",
    "工具宿主边界",
    "状态控制器"
  ],
  "scenarios": [
    {
      "name": "direct-send-callback-success",
      "roleFlow": ["manager", "executor", "verifier"],
      "executorDelivery": "direct-send",
      "fallback": "self-thread-marker",
      "expectedStatus": "verifying",
      "requiredLedgerFields": ["returnThreadId", "returnSearchAnchor", "fallbackSearchAnchor"]
    },
    {
      "name": "direct-send-missed-self-thread-fallback",
      "roleFlow": ["manager", "executor", "verifier"],
      "executorDelivery": "self-thread-marker",
      "fallback": "read_thread searchAnchor",
      "expectedStatus": "verifying",
      "requiredLedgerFields": ["searchAnchor", "fallbackSearchAnchor"]
    },
    {
      "name": "verifier-needs-rework",
      "roleFlow": ["executor", "verifier", "executor"],
      "verdict": "needs_rework",
      "expectedStatus": "needs_rework",
      "requiresUserApprovalBeforeRedispatch": true
    },
    {
      "name": "verifier-blocked-closeout",
      "roleFlow": ["executor", "verifier"],
      "verdict": "blocked",
      "expectedStatus": "blocked",
      "expectedUserOutput": "Team Router Closeout"
    }
  ]
}
